# Vercel Postgres / Prisma Postgres Pooled & Direct Connections
DATABASE_PRISMA_DATABASE_URL="postgresql://username:password@ep-hostname-pooler.region.aws.neon.tech/wealthydb?pgbouncer=true&connect_timeout=15"
DATABASE_POSTGRES_URL="postgresql://username:password@ep-hostname.region.aws.neon.tech/wealthydb?sslmode=require"

# Default Admin Credentials for Username & Password Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# JWT Secret Key (Minimum 32 characters for HS256 signing)
JWT_SECRET="replace_with_a_secure_random_32_char_secret_key_here"
